# Copy to .env next to the repo root (or cwd). Runtime auto-loads it at startup
# without overriding variables already set in the shell. Not all keys are required.
#
# Deploy model: host Runtime + host Agents; optional engine containers.
# See docs/DEPLOY.md

# Data root (default: <repo>/data). Use an absolute path for OS user dirs.
# AGENTDOCK_HOME=

# Device WebSocket URL for clients (CLI / mobile / Pi)
# AGENTDOCK_URL=ws://127.0.0.1:8765

# Device auth token (required when Runtime binds 0.0.0.0; see data/state/device-auth.json)
# AGENTDOCK_TOKEN=

# Optional Admin token for non-loopback Admin API access
# AGENTDOCK_ADMIN_TOKEN=

# GPT-SoVITS (when started from Admin)
# AGENTDOCK_GPT_SOVITS_ROOT=
# AGENTDOCK_GPT_SOVITS_PYTHON=
# AGENTDOCK_GPT_SOVITS_API_PORT=19880

# Playwright MCP extension token (if using browser tools)
# PLAYWRIGHT_MCP_EXTENSION_TOKEN=
