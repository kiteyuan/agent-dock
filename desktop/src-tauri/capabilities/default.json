{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main pet window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-skip-taskbar",
    "opener:default",
    "allow-local-device-token",
    "allow-fit-pet-window",
    "allow-open-admin-panel",
    "allow-admin-api",
    "allow-shutdown-host",
    "allow-start-pet-drag",
    "allow-pet-window-pos",
    "allow-pet-hit-rects",
    "allow-secure-device-token"
  ]
}
