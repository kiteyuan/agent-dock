{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "admin",
  "description": "Console window on fixed loopback :8767 Dist; API via allowlisted admin_api",
  "windows": ["admin"],
  "remote": {
    "urls": ["http://127.0.0.1:8767/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-close",
    "core:webview:allow-set-webview-focus",
    "allow-admin-api"
  ]
}
