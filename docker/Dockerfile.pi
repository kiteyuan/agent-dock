# Pi Coding Agent HTTP gateway for AgentDock
# Build: docker build -f docker/Dockerfile.pi -t agentdock-pi .
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/agents/pi-coding

COPY agents/pi-coding/package.json ./
RUN npm install --omit=dev

COPY agents/pi-coding/gateway.py agents/pi-coding/voice_prompt.txt ./

# Listen on all container interfaces so the Runtime container can reach this
# process. Compose does not publish the port to the host.
ENV PI_GATEWAY_HOST=0.0.0.0 \
    PI_GATEWAY_PORT=9001 \
    PI_CWD=/workspace \
    PI_SESSION_DIR=/data/sessions \
    PYTHONUNBUFFERED=1

RUN mkdir -p /workspace /data/sessions

EXPOSE 9001

CMD ["python3", "gateway.py"]
