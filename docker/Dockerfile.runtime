# AgentDock Runtime (STT/TTS client + Device WS + pets HTTP)
# Build: docker build -f docker/Dockerfile.runtime -t agentdock-runtime .
FROM python:3.11-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY runtime ./runtime

RUN pip install --no-cache-dir -e .

# Data paths are bind-mounted; keep placeholders so relative paths resolve.
RUN mkdir -p /app/pets /app/voices /app/workspace

ENV PYTHONUNBUFFERED=1 \
    HF_HOME=/cache/huggingface

EXPOSE 8765 8766

CMD ["python", "-m", "runtime", "/app/config.yaml"]
